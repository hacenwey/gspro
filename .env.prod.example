# ============================================
# PRODUCTION ENV (Lightsail / AWS)
# Copy to .env.prod and fill in REAL secrets.
# NEVER commit .env.prod to git.
# ============================================

# ---- MySQL root + app user ----
MYSQL_ROOT_PASSWORD=change_me_root_long_random
MYSQL_DATABASE=gestionpro_master
MYSQL_USER=gestion
MYSQL_PASSWORD=change_me_app_long_random

# ---- Values injected into the PHP container ----
DB_NAME=gestion_commerciale
DB_USER=gestion
DB_PASS=change_me_app_long_random

# ---- Backups (S3 / R2). Leave blank to skip upload. ----
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-3
